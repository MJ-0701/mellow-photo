require 'base64'
require 'fileutils'
require 'open3'
require 'shellwords'
require 'securerandom'
require 'plist'
require 'digest'
require_relative 'release_notes'

def required(name)
  value = ENV[name]
  UI.user_error!("Missing required setting: #{name}") if value.to_s.empty?
  value
end

def quiet_command(*args)
  stdout, stderr, status = Open3.capture3(*args)
  unless status.success?
    # Report only fixed diagnostic labels, never raw output or command arguments:
    # import and keychain commands can contain certificate passwords.
    category = case stderr
               when /password|passphrase|MAC verification/i then 'authentication-or-decryption'
               when /already exists/i then 'already-exists'
               when /no such file|not found|could not be found/i then 'missing-file-or-item'
               when /interaction.*not allowed|authorization.*denied|permission denied/i then 'permission-or-interaction'
               when /decode|malformed|invalid.*(data|format)/i then 'invalid-input-format'
               else 'unclassified'
               end
    operation = File.basename(args.first)
    if operation == 'security'
      allowed_operations = %w[cms create-keychain set-keychain-settings unlock-keychain import set-key-partition-list list-keychains find-identity]
      operation += " #{args[1]}" if allowed_operations.include?(args[1])
    end
    UI.user_error!("Command failed: #{operation}; exit=#{status.exitstatus}; category=#{category} (sensitive output withheld)")
  end
  stdout
end

def read_plist(path)
  Plist.parse_xml(quiet_command('/usr/bin/plutil', '-convert', 'xml1', '-o', '-', path), marshal: false)
end

def decode_secret(name, path)
  File.write(path, Base64.strict_decode64(required(name)), mode: 'wb', perm: 0600)
rescue ArgumentError
  UI.user_error!("#{name} must contain base64 without line breaks")
end

def verify_bundle(path, team, version, build)
  quiet_command('/usr/bin/codesign', '--verify', '--deep', '--strict', path)
  info = read_plist(File.join(path, 'Info.plist'))
  UI.user_error!('Unexpected bundle identity or version') unless
    info['CFBundleIdentifier'] == 'com.mj.mellowphoto' &&
    info['CFBundleShortVersionString'] == version && info['CFBundleVersion'] == build
  entitlements = Plist.parse_xml(quiet_command('/usr/bin/codesign', '-d', '--entitlements', ':-', path), marshal: false)
  UI.user_error!('Unexpected signing entitlements') unless
    entitlements['com.apple.developer.team-identifier'] == team &&
    entitlements['application-identifier'] == "#{team}.com.mj.mellowphoto" &&
    entitlements['get-task-allow'] != true
end

# Signs, builds, and verifies the App Store IPA through one shared path for every lane.
# before_build runs after the App Store Connect key is ready and before the slow build,
# so a lane can fail fast on store-side preconditions.
# The block receives the API key, IPA path, version, and build after both bundle checks pass.
# Temporary signing material is removed after the block returns or raises.
def with_signed_ipa(before_build: nil)
  UI.user_error!('Run through the protected GitHub release workflow') unless ENV['GITHUB_ACTIONS'] == 'true'
  team = required('APPLE_TEAM_ID')
  version = required('APP_VERSION')
  build = required('APP_BUILD')
  UI.user_error!('Invalid team, version, or build') unless team.match?(/\A[A-Z0-9]{10}\z/) &&
    version.match?(/\A\d+\.\d+\.\d+\z/) && build.match?(/\A\d+\.\d+\z/)
  root = File.expand_path('..', __dir__)
  signing = File.join(required('RUNNER_TEMP'), 'mellow-signing')
  keychain = File.join(ENV['RUNNER_TEMP'], 'mellow-release.keychain-db')
  FileUtils.mkdir_p(signing, mode: 0700)
  p12 = File.join(signing, 'distribution.p12')
  profile_path = File.join(signing, 'appstore.mobileprovision')
  decode_secret('DISTRIBUTION_P12_BASE64', p12)
  decode_secret('APPSTORE_PROFILE_BASE64', profile_path)
  profile = Plist.parse_xml(quiet_command('/usr/bin/security', 'cms', '-D', '-i', profile_path), marshal: false)
  entitlements = profile.fetch('Entitlements')
  UI.user_error!('Profile must be unexpired App Store distribution for this app/team') unless
    profile['TeamIdentifier'].include?(team) && profile['ExpirationDate'].to_time > Time.now &&
    entitlements['application-identifier'] == "#{team}.com.mj.mellowphoto" &&
    entitlements['get-task-allow'] != true && !profile.key?('ProvisionedDevices') &&
    profile['ProvisionsAllDevices'] != true
  password = SecureRandom.hex(32)
  quiet_command('/usr/bin/security', 'create-keychain', '-p', password, keychain)
  quiet_command('/usr/bin/security', 'set-keychain-settings', '-lut', '7200', keychain)
  quiet_command('/usr/bin/security', 'unlock-keychain', '-p', password, keychain)
  quiet_command('/usr/bin/security', 'import', p12, '-k', keychain, '-P', required('DISTRIBUTION_P12_PASSWORD'), '-T', '/usr/bin/codesign', '-T', '/usr/bin/security')
  quiet_command('/usr/bin/security', 'set-key-partition-list', '-S', 'apple-tool:,apple:,codesign:', '-s', '-k', password, keychain)
  previous_keychains = Shellwords.split(quiet_command('/usr/bin/security', 'list-keychains', '-d', 'user'))
  quiet_command('/usr/bin/security', 'list-keychains', '-d', 'user', '-s', keychain, *previous_keychains)
  identities = quiet_command('/usr/bin/security', 'find-identity', '-v', '-p', 'codesigning', keychain)
  identity = identities[/([0-9A-F]{40}) "Apple Distribution:/, 1]
  UI.user_error!('P12 has no valid Apple Distribution private-key identity') unless identity
  cert_hashes = profile.fetch('DeveloperCertificates').map { |cert| Digest::SHA1.hexdigest(cert.respond_to?(:read) ? cert.read : cert).upcase }
  UI.user_error!('Certificate does not belong to provisioning profile') unless cert_hashes.include?(identity)
  # Xcode 16+ profile location; deterministic filename enables cleanup even on failure.
  installed_profile = File.expand_path('~/Library/Developer/Xcode/UserData/Provisioning Profiles/mellow-ci.mobileprovision')
  FileUtils.mkdir_p(File.dirname(installed_profile))
  FileUtils.cp(profile_path, installed_profile)
  api_key = app_store_connect_api_key(key_id: required('ASC_KEY_ID'), issuer_id: required('ASC_ISSUER_ID'),
    key_content: required('ASC_KEY_BASE64'), is_key_content_base64: true, in_house: false)
  before_build&.call(root: root, version: version)
  xcargs = {
    'DEVELOPMENT_TEAM' => team, 'CODE_SIGN_STYLE' => 'Manual',
    'CODE_SIGN_IDENTITY' => identity, 'PROVISIONING_PROFILE_SPECIFIER' => profile.fetch('UUID'),
    'MARKETING_VERSION' => version, 'CURRENT_PROJECT_VERSION' => build,
    'OTHER_CODE_SIGN_FLAGS' => "--keychain #{keychain}"
  }.map { |key, value| "#{key}=#{Shellwords.escape(value)}" }.join(' ')
  archive = File.join(root, 'dist', 'MellowPhoto.xcarchive')
  ipa = build_app(project: File.join(root, 'apple/MellowPhoto.xcodeproj'), scheme: 'MellowPhoto',
    configuration: 'Release', clean: true, archive_path: archive, destination: 'generic/platform=iOS',
    output_directory: File.join(root, 'dist'), output_name: 'MellowPhoto.ipa',
    export_method: 'app-store', skip_profile_detection: true,
    export_options: { signingStyle: 'manual', teamID: team, signingCertificate: identity,
      provisioningProfiles: { 'com.mj.mellowphoto' => profile.fetch('UUID') } }, xcargs: xcargs)
  verify_bundle(Dir[File.join(archive, 'Products/Applications/*.app')].fetch(0), team, version, build)
  unpacked = File.join(signing, 'exported')
  quiet_command('/usr/bin/ditto', '-x', '-k', ipa, unpacked)
  verify_bundle(Dir[File.join(unpacked, 'Payload/*.app')].fetch(0), team, version, build)
  yield(api_key, ipa, version, build)
ensure
  if previous_keychains
    Open3.capture3('/usr/bin/security', 'list-keychains', '-d', 'user', '-s', *previous_keychains)
  end
  Open3.capture3('/usr/bin/security', 'delete-keychain', keychain) if keychain
  FileUtils.rm_f(installed_profile) if installed_profile
  FileUtils.rm_rf(signing) if signing
end

TESTFLIGHT_GROUPS = ['Mellow Photo Internal', 'Mellow Photo External'].freeze
DEFAULT_WHAT_TO_TEST = '새 기능과 수정 사항을 확인해 주세요.'.freeze

# "What to Test" text comes from fastlane/release_notes/<version>.json (ko) when present.
def what_to_test(version)
  path = File.expand_path("release_notes/#{version}.json", __dir__)
  return DEFAULT_WHAT_TO_TEST unless File.file?(path)
  text = JSON.parse(File.read(path)).fetch('ko', '').strip
  text.empty? ? DEFAULT_WHAT_TO_TEST : text
end

# Internal group gets the build at once; the external group gets it after Apple's beta review.
def testflight_distribution(version)
  {
    groups: TESTFLIGHT_GROUPS,
    distribute_external: true,
    notify_external_testers: true,
    changelog: what_to_test(version),
    skip_submission: false
  }
end

default_platform(:ios)
platform :ios do
  desc 'Build a signed App Store IPA, upload, and optionally submit for review'
  lane :release do
    app = nil
    release_notes = nil
    prepare_store_version = lambda do |root:, version:|
      app = Spaceship::ConnectAPI::App.find('com.mj.mellowphoto')
      release_notes = MellowReleaseNotes.prepare(app: app, version: version, directory: File.join(root, 'fastlane/release_notes'))
    end
    with_signed_ipa(before_build: prepare_store_version) do |api_key, ipa, version, build|
      upload_to_app_store(api_key: api_key, app_identifier: 'com.mj.mellowphoto', ipa: ipa,
        app_version: version, skip_metadata: true, skip_screenshots: true,
        submit_for_review: false, precheck_include_in_app_purchases: false, force: true)
      # deliver ignores automatic_release when skip_metadata is true. Change only
      # releaseType explicitly, preserving the user's store text and screenshots.
      store_version = app.get_edit_app_store_version(platform: 'IOS')
      UI.user_error!('No matching editable App Store version') unless store_version && store_version.version_string == version
      release_notes&.apply!(store_version)
      release_type = ENV['AUTOMATIC_RELEASE'] == 'true' ? 'AFTER_APPROVAL' : 'MANUAL'
      store_version.update(attributes: { releaseType: release_type })
      if ENV['SUBMIT_FOR_REVIEW'] == 'true'
        upload_to_app_store(api_key: api_key, app_identifier: 'com.mj.mellowphoto',
          app_version: version, build_number: build, skip_binary_upload: true,
          skip_metadata: true, skip_screenshots: true, submit_for_review: true,
          precheck_include_in_app_purchases: false, force: true)
      end
    end
  end

  desc 'Build a signed App Store IPA, upload it to TestFlight and distribute it to both tester groups, without touching any App Store version'
  lane :beta do
    with_signed_ipa do |api_key, ipa, version, _build|
      # Distribution needs a processed build, so this waits for Apple's processing.
      upload_to_testflight(api_key: api_key, ipa: ipa, app_identifier: 'com.mj.mellowphoto',
        skip_waiting_for_build_processing: false, **testflight_distribution(version))
    end
  end

  desc 'Distribute an already uploaded build to both tester groups (internal now, external after beta review)'
  lane :distribute do
    version = required('APP_VERSION')
    build = required('APP_BUILD')
    UI.user_error!('Invalid version or build') unless version.match?(/\A\d+\.\d+\.\d+\z/) && build.match?(/\A\d+\.\d+\z/)
    api_key = app_store_connect_api_key(key_id: required('ASC_KEY_ID'), issuer_id: required('ASC_ISSUER_ID'),
      key_content: required('ASC_KEY_BASE64'), is_key_content_base64: true, in_house: false)
    upload_to_testflight(api_key: api_key, app_identifier: 'com.mj.mellowphoto', distribute_only: true,
      app_version: version, build_number: build, app_platform: 'ios', **testflight_distribution(version))
  end

  # Internal testers must be App Store Connect users. Marketing is the least-privileged role Apple allows for internal testing.
  desc 'Invite an internal tester as an App Store Connect user, then (after acceptance) add them to the internal group'
  lane :internal_tester do
    email = required('TESTER_EMAIL')
    first_name = required('TESTER_FIRST_NAME')
    last_name = required('TESTER_LAST_NAME')
    app_store_connect_api_key(key_id: required('ASC_KEY_ID'), issuer_id: required('ASC_ISSUER_ID'),
      key_content: required('ASC_KEY_BASE64'), is_key_content_base64: true, in_house: false)
    app = Spaceship::ConnectAPI::App.find('com.mj.mellowphoto')
    UI.user_error!('App com.mj.mellowphoto not found') unless app
    user = Spaceship::ConnectAPI::User.find(email: email).first
    unless user
      if Spaceship::ConnectAPI::UserInvitation.find(email: email).first
        UI.important('Invitation already sent. Run this again after the tester accepts it.')
      else
        Spaceship::ConnectAPI::UserInvitation.create(email: email, first_name: first_name, last_name: last_name,
          roles: ['MARKETING'], provisioning_allowed: false, all_apps_visible: true)
        UI.success('Invitation sent. Run this again after the tester accepts it.')
      end
      next
    end
    group = app.get_beta_groups.find { |candidate| candidate.name == TESTFLIGHT_GROUPS.first }
    UI.user_error!("Beta group #{TESTFLIGHT_GROUPS.first} not found") unless group
    group.post_bulk_beta_tester_assignments(beta_testers: [
      { email: email, firstName: first_name, lastName: last_name, errors: [] }
    ])
    UI.success("Added to #{group.name}. Builds already in that group are available now.")
  end

  desc 'Read-only: print recent TestFlight builds and beta groups (no tester emails, no changes)'
  lane :build_status do
    app_store_connect_api_key(key_id: required('ASC_KEY_ID'), issuer_id: required('ASC_ISSUER_ID'),
      key_content: required('ASC_KEY_BASE64'), is_key_content_base64: true, in_house: false)
    app = Spaceship::ConnectAPI::App.find('com.mj.mellowphoto')
    UI.user_error!('App com.mj.mellowphoto not found') unless app
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: '-uploadedDate', limit: 10,
      includes: 'preReleaseVersion,buildBetaDetail')
    UI.header('Recent builds (newest first)')
    builds.each do |build|
      detail = build.build_beta_detail
      columns = [
        "version=#{build.app_version}",
        "build=#{build.version}",
        "uploaded=#{build.uploaded_date}",
        "processing=#{build.processing_state}",
        "internal=#{detail&.internal_build_state || '-'}",
        "external=#{detail&.external_build_state || '-'}",
        "expired=#{build.expired}",
        "encryption=#{build.uses_non_exempt_encryption.inspect}"
      ]
      UI.message(columns.join('  '))
    end
    UI.header('Beta groups')
    app.get_beta_groups.each do |group|
      testers = begin
        Spaceship::ConnectAPI.get_beta_testers(filter: { betaGroups: group.id }, limit: 200).to_models.size
      rescue StandardError
        'unknown'
      end
      all_builds = group.respond_to?(:has_access_to_all_builds) ? group.has_access_to_all_builds.inspect : 'unknown'
      UI.message("name=#{group.name}  internal=#{group.is_internal_group}  testers=#{testers}  all_builds=#{all_builds}")
    end
  end
end
