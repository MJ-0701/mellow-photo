{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mellow.photo/schema/edit-recipe.v2.schema.json",
  "title": "Mellow Photo EditRecipe v2",
  "description": "사진 한 장의 보정 레시피. 좌표는 방향 보정된 이미지 기준 정규화(0~1), 원점은 왼쪽 아래. 모든 플랫폼 구현이 같은 파일을 읽고 쓴다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposure": { "type": "number", "default": 0, "minimum": -3, "maximum": 3 },
        "contrast": { "type": "number", "default": 1, "minimum": 0, "maximum": 2 },
        "saturation": { "type": "number", "default": 1, "minimum": 0, "maximum": 2 },
        "warmth": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 }
      }
    },
    "portrait": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oneTouch": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "default": null, "description": "원터치 표시(G4). 전체 층의 묶인 항목(skin 9종·features 3종·makeup.blush·makeup.lip)이 OneTouchBundle 공통 표 × 이 강도와 같고 bodySkin.brightness가 몸 피부 표 × 이 강도와 같다는 뜻이다. 렌더는 읽지 않는다. 없으면 표시 없음." },
        "targetFace": { "type": ["integer", "null"], "default": null, "deprecated": true, "description": "B0~G의 읽기 전용 키. people.individuals가 없을 때만 전체 층 값을 그 인덱스 사람의 개인 층(legacyIndex)으로 옮겨 읽는다. 쓰지 않는다." },
        "skin": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "smoothing": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 },
            "autoBlemish": { "type": "boolean", "default": false },
            "darkCircles": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 },
            "nasolabial": { "type": "number", "default": 0, "minimum": 0, "maximum": 1, "description": "팔자주름(코 날개 → 입꼬리)." },
            "marionette": { "type": "number", "default": 0, "minimum": 0, "maximum": 1, "description": "마리오네트 주름(입꼬리 → 턱 쪽)." },
            "glabella": { "type": "number", "default": 0, "minimum": 0, "maximum": 1, "description": "미간 주름." },
            "toneEvening": { "type": "number", "default": 0, "minimum": 0, "maximum": 1, "description": "피부 얼룩 고르기(저주파를 피부 평균 쪽으로)." },
            "redness": { "type": "number", "default": 0, "minimum": -1, "maximum": 1, "description": "음수는 맑게(붉은 반점 줄임), 양수는 혈색." },
            "shine": { "type": "number", "default": 0, "minimum": 0, "maximum": 1, "description": "번들거림(밝은 반사 영역을 피부 평균 쪽으로)." }
          }
        },
        "face": {
          "type": "object", "additionalProperties": false,
          "description": "가운데 0인 양방향. width 음수는 좁게. smile만 0~1.",
          "properties": {
            "width": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
            "jaw": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
            "cheekbone": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
            "eyeSize": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
            "eyeDistance": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
            "noseWidth": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
            "mouthSize": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
            "smile": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 },
            "forehead": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
            "chinLength": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 }
          }
        },
        "features": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "eyeBrighten": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 },
            "teethWhiten": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 },
            "lipVitality": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 }
          }
        },
        "skinSmoothing": { "type": "number", "minimum": 0, "maximum": 1, "deprecated": true, "description": "B0까지의 읽기 전용 키. skin이 없을 때만 skin.smoothing으로 읽는다. 쓰지 않는다." },
        "faceSlim": { "type": "number", "minimum": 0, "maximum": 1, "deprecated": true, "description": "B0까지의 읽기 전용 키. face가 없을 때만 face.width = −faceSlim으로 읽는다. 쓰지 않는다." }
      }
    },
    "detail": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "highlights": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
        "shadows": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
        "sharpness": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 },
        "vignette": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 }
      }
    },
    "look": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": ["string", "null"], "default": null, "description": "shared/looks/looks.v1.json의 룩 id" },
        "intensity": { "type": "number", "default": 1, "minimum": 0, "maximum": 1 }
      }
    },
    "geometry": {
      "type": "object", "additionalProperties": false,
      "description": "반전 → 90° 회전 → 수평 보정 → 자르기 순서. crop은 그 앞 단계가 끝난 이미지 기준 정규화 사각형.",
      "properties": {
        "flipHorizontal": { "type": "boolean", "default": false },
        "quarterTurns": { "type": "integer", "default": 0, "minimum": 0, "maximum": 3 },
        "straightenDegrees": { "type": "number", "default": 0, "minimum": -15, "maximum": 15 },
        "crop": {
          "type": ["object", "null"], "default": null, "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "background": {
      "type": "object", "additionalProperties": false,
      "properties": { "blur": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 } }
    },
    "bodySkin": {
      "type": "object", "additionalProperties": false,
      "description": "보이는 피부 전체(인물 마스크 × 피부색). tone만 가운데 0인 양방향.",
      "properties": {
        "brightness": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 },
        "tone": { "type": "number", "default": 0, "minimum": -1, "maximum": 1, "description": "양수는 따뜻하게, 음수는 차갑게." },
        "smoothing": { "type": "number", "default": 0, "minimum": 0, "maximum": 1, "description": "얼굴 피부 영역을 뺀 몸 피부만." }
      }
    },
    "body": {
      "type": "object", "additionalProperties": false,
      "description": "가운데 0인 양방향. legLength만 0~1.",
      "properties": {
        "legLength": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 },
        "waist": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
        "overall": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
        "arms": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
        "thighs": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
        "shoulders": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 },
        "neck": { "type": "number", "default": 0, "minimum": -1, "maximum": 1 }
      }
    },
    "makeup": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "lookID": { "type": ["string", "null"], "default": null, "description": "shared/makeup/makeup.v1.json의 룩 id. 마지막으로 적용한 룩." },
        "lip": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "colorID": { "type": ["string", "null"], "default": null },
            "intensity": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 }
          }
        },
        "blush": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "colorID": { "type": ["string", "null"], "default": null },
            "intensity": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 }
          }
        },
        "eyeshadow": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "colorID": { "type": ["string", "null"], "default": null },
            "intensity": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 }
          }
        },
        "brow": {
          "type": "object", "additionalProperties": false,
          "properties": { "intensity": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 } }
        },
        "contour": {
          "type": "object", "additionalProperties": false,
          "properties": { "intensity": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 } }
        }
      }
    },
    "effects": {
      "type": "object", "additionalProperties": false,
      "description": "룩 뒤 마지막 단계. 분석이 필요 없다.",
      "properties": {
        "grain": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 },
        "glow": { "type": "number", "default": 0, "minimum": 0, "maximum": 1 }
      }
    },
    "people": {
      "type": "object", "additionalProperties": false,
      "description": "사람별·성별 그룹 보정. 전체(portrait·makeup) → 성별 그룹 → 개인 순서로 키 단위로 덮어쓴다. anchor는 정규화 얼굴 상자 중심과 폭이고 같은 사람 판정은 폭의 50% 거리·크기 비 2배 이내.",
      "properties": {
        "groups": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "male": { "$ref": "#/$defs/portraitLayer" },
            "female": { "$ref": "#/$defs/portraitLayer" }
          }
        },
        "individuals": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "layer"],
            "anyOf": [{ "required": ["anchor"] }, { "required": ["legacyIndex"] }],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "anchor": {
                "type": "object", "additionalProperties": false,
                "required": ["x", "y", "width"],
                "properties": {
                  "x": { "type": "number", "minimum": 0, "maximum": 1 },
                  "y": { "type": "number", "minimum": 0, "maximum": 1 },
                  "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
                }
              },
              "legacyIndex": { "type": "integer", "minimum": 0, "description": "옛 targetFace에서 이행한 기록만. anchor가 채워지면 사라진다." },
              "gender": { "enum": ["male", "female"], "description": "수동 지정. 자동 추정은 저장하지 않는다." },
              "layer": { "$ref": "#/$defs/portraitLayer" }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "description": "사용자가 기록한 순서대로 재생한다.",
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "x", "y", "sourceX", "sourceY", "radius"],
            "properties": {
              "type": { "const": "spot" },
              "x": { "type": "number" }, "y": { "type": "number" },
              "sourceX": { "type": "number" }, "sourceY": { "type": "number" },
              "radius": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["type", "x", "y", "dx", "dy", "radius"],
            "properties": {
              "type": { "const": "warp" },
              "x": { "type": "number" }, "y": { "type": "number" },
              "dx": { "type": "number" }, "dy": { "type": "number" },
              "radius": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "portraitLayer": {
      "type": "object", "additionalProperties": false,
      "description": "성긴 층. 있는 키만 아래 층을 덮어쓰고 없는 키는 상속한다.",
      "properties": {
        "oneTouch": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "default": null, "description": "원터치 표시(G4). 이 층의 묶인 항목이 OneTouchBundle 표(그룹은 그 성별, 개인은 수동 성별, 미지정은 공통) × 이 강도와 같다는 뜻이다. 렌더는 읽지 않고 덮어쓰는 키도 아니다. 없으면 표시 없음." },
        "skin": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "smoothing": { "type": "number", "minimum": 0, "maximum": 1 },
            "autoBlemish": { "type": "boolean" },
            "darkCircles": { "type": "number", "minimum": 0, "maximum": 1 },
            "nasolabial": { "type": "number", "minimum": 0, "maximum": 1 },
            "marionette": { "type": "number", "minimum": 0, "maximum": 1 },
            "glabella": { "type": "number", "minimum": 0, "maximum": 1 },
            "toneEvening": { "type": "number", "minimum": 0, "maximum": 1 },
            "redness": { "type": "number", "minimum": -1, "maximum": 1 },
            "shine": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "face": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "width": { "type": "number", "minimum": -1, "maximum": 1 },
            "jaw": { "type": "number", "minimum": -1, "maximum": 1 },
            "cheekbone": { "type": "number", "minimum": -1, "maximum": 1 },
            "eyeSize": { "type": "number", "minimum": -1, "maximum": 1 },
            "eyeDistance": { "type": "number", "minimum": -1, "maximum": 1 },
            "noseWidth": { "type": "number", "minimum": -1, "maximum": 1 },
            "mouthSize": { "type": "number", "minimum": -1, "maximum": 1 },
            "smile": { "type": "number", "minimum": 0, "maximum": 1 },
            "forehead": { "type": "number", "minimum": -1, "maximum": 1 },
            "chinLength": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        },
        "features": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "eyeBrighten": { "type": "number", "minimum": 0, "maximum": 1 },
            "teethWhiten": { "type": "number", "minimum": 0, "maximum": 1 },
            "lipVitality": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "makeup": {
          "type": "object", "additionalProperties": false,
          "description": "부위 단위로 덮어쓴다. 부위 객체가 있으면 색과 강도를 함께 덮어쓰고 colorID가 없거나 null이면 색 없음이다.",
          "properties": {
            "lookID": { "type": ["string", "null"], "description": "이 층에서 마지막으로 적용한 룩 id." },
            "lip": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "colorID": { "type": ["string", "null"] },
                "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            },
            "blush": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "colorID": { "type": ["string", "null"] },
                "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            },
            "eyeshadow": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "colorID": { "type": ["string", "null"] },
                "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            },
            "brow": {
              "type": "object", "additionalProperties": false,
              "properties": { "intensity": { "type": "number", "minimum": 0, "maximum": 1 } }
            },
            "contour": {
              "type": "object", "additionalProperties": false,
              "properties": { "intensity": { "type": "number", "minimum": 0, "maximum": 1 } }
            }
          }
        }
      }
    }
  }
}
